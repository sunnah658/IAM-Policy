{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowStartStopReboot",
            "Effect": "Allow",
            "Action": [
                "ec2:StartInstances",
                "ec2:StopInstances",
                "ec2:RebootInstances"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DenyTerminateInstances",
            "Effect": "Deny",
            "Action": [
                "ec2:TerminateInstances"
            ],
            "Resource": "*"
        }
    ]
}