{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "allowviewinglogandmetrics",
            "Effect": "Allow",
            "Action": [
                "cloudwatch:Describe*",
                "cloudwatch:Get*",
                "cloudwatch:List*",
                "logs:Describe*",
                "logs:Get*",
                "logs:List*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "denydeleteloggroups",
            "Effect": "Deny",
            "Action": [
                "logs:DeleteLogGroup",
                "logs:DeleteLogStream"
            ],
            "Resource": "*"
        }
    ]
}