{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "Allows3accessonfolder",
            "Effect": "Allow",
            "Action": [
                "s3:putObject",
                "s3:getObject"
            ],
            "Resource": "arn:aws:s3:::class/*"
        },
        {
            "Sid": "Denyaccessonotherfolders",
            "Effect": "Deny",
            "Action": [
                "s3:*"
            ],
            "NotResource": "arn:aws:s3:::class/*"
        }
    ]
}