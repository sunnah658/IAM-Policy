{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "Allowreadandupload",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Resource": [
                "arn:aws:s3:::class/test.txt"
            ]
        },
        {
            "Sid": "explicitlyDenydelete",
            "Effect": "Deny",
            "Action": [
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::class/test.txt"
            ]
        }
    ]
}