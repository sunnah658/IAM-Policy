{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "allowpublicreadfors3",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::class/*"
        },
        {
            "Sid": "explicitdenyupload",
            "Effect": "Deny",
            "Action": [
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::class/*"
        }
    ]
}