{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "allowpublicreadfors3",
            "Effect": "Allow",
            "Principal": "*",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::class/*"
        },
        {
            "Sid": "allowuploadtospecificuser",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::123456789012:user/sunnah"
            },
            "Action": [
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::class/*"
        },
        {
            "Sid": "explicitedenytoalluser",
            "Effect": "Deny",
            "NotPrincipal": {
                "AWS": "arn:aws:iam::123456789012:user/sunnah"
            },
            "Action": [
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::class/*"
        }
    ]
}